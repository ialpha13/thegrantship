# Hosting (Hostinger): site lives at domain root (/public_html)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(config|partials)/ - [F,L]
RewriteRule ^db\.sql$ - [F,L]
RewriteRule \.(env|ini|log|sql)$ - [F,L]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.thegrantship\.com$ [NC]
RewriteRule ^ https://thegrantship.com%{REQUEST_URI} [L,R=301]
</IfModule>
ErrorDocument 400 /errors/error-handler.php?code=400
ErrorDocument 401 /errors/error-handler.php?code=401
ErrorDocument 403 /errors/error-handler.php?code=403
ErrorDocument 404 /errors/error-handler.php?code=404
ErrorDocument 429 /errors/error-handler.php?code=429
ErrorDocument 500 /errors/error-handler.php?code=500
ErrorDocument 503 /errors/error-handler.php?code=503
